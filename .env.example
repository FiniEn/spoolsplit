# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The public "anon" key (also accepted: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by /api/ai/* routes
GEMINI_API_KEY=your-gemini-key
# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: models to fall back to when the first is busy ("high demand"), comma-separated
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Required: PIN that unlocks the app (pages, app code and AI routes). Use 6+ digits.
WORKSPACE_PIN=123456
