# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The public "anon" key (also accepted: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by /api/ai/* routes
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the Claude model (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Required: PIN that unlocks the app (pages, app code and AI routes). Use 6+ digits.
WORKSPACE_PIN=123456
